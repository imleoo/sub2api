# 全功能 E2E 上游凭证模板
# ============================================================================
# 复制为 script/e2e.env（该文件已被 .gitignore 忽略，绝不会提交），填入真实凭证。
# script/e2e-test.sh 会自动 source 它。
#
#   cp script/e2e.env.example script/e2e.env
#   # 编辑 script/e2e.env 填入真实 key
#   ./script/e2e-test.sh        # 或 cd backend && make test-e2e
#
# ⚠️ 切勿把含真实 key 的 script/e2e.env 提交到仓库。

# ── Anthropic / Claude（必需）──────────────────────────────────────────────
export E2E_ANTHROPIC_UPSTREAM_KEY="sk-your-anthropic-upstream-key"
export E2E_ANTHROPIC_UPSTREAM_BASE_URL="https://api.anthropic.com"
export E2E_ANTHROPIC_MODEL="claude-sonnet-4-6"

# ── OpenAI（可选，配了才跑 OpenAI 用例）─────────────────────────────────────
export E2E_OPENAI_UPSTREAM_KEY="sk-your-openai-upstream-key"
export E2E_OPENAI_UPSTREAM_BASE_URL="https://api.openai.com/v1"
export E2E_OPENAI_MODEL="gpt-4o-mini"

# ── Gemini（可选，配了才跑 Gemini 用例）─────────────────────────────────────
export E2E_GEMINI_UPSTREAM_KEY="sk-your-gemini-upstream-key"
export E2E_GEMINI_UPSTREAM_BASE_URL="https://generativelanguage.googleapis.com"
export E2E_GEMINI_MODEL="gemini-3.5-flash"

# ── 可选：被测服务 / 管理员（默认自动用 dev_local 起服务 + 其默认管理员）──────
# export E2E_BASE_URL="http://127.0.0.1:8091"   # 设了就用已运行实例，不自动起停
# export E2E_ADMIN_EMAIL="admin@sub2api.local"
# export E2E_ADMIN_PASSWORD="admin123"

# ── Bedrock Converse 协议验证（可选，配了才跑 converse 协议对拍用例）──────────────
# openclaw 标准上游：仅用于取真实 native 金样本 + 标准请求验证（openclaw 不吐 Converse 二进制帧）
export E2E_BEDROCK_CONVERSE_UPSTREAM_KEY="sk-your-openclaw-key"
export E2E_BEDROCK_CONVERSE_UPSTREAM_BASE_URL="https://openclaw.zhiguo.fan"
export E2E_BEDROCK_CONVERSE_MODEL="claude-sonnet-4-6"
